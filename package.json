{
	"name": "svelte-stash",
	"version": "1.1.0",
	"description": "A lightweight state manager for Svelte 5",
	"author": "Atif C <atifcdev@gmail.com>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atif-c/svelte-stash.git"
	},
	"bugs": {
		"url": "https://github.com/atif-c/svelte-stash/issues"
	},
	"homepage": "https://github.com/atif-c/svelte-stash#readme",
	"type": "module",
	"packageManager": "pnpm@11.6.0",
	"main": "dist/index.svelte.js",
	"types": "dist/index.svelte.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.svelte.d.ts",
			"default": "./dist/index.svelte.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist",
		"!dist/**/*.test.*"
	],
	"keywords": [
		"svelte",
		"svelte5",
		"stash",
		"state",
		"state-management",
		"persistence",
		"storage",
		"reactive",
		"runes",
		"debounce",
		"localStorage",
		"database",
		"cookies",
		"session",
		"authentication",
		"sync"
	],
	"scripts": {
		"build": "npm run prepack",
		"test": "vitest run",
		"test:watch": "vitest --watch",
		"test:coverage": "vitest run --coverage",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"prettier:check": "prettier --check .",
		"prettier:write": "prettier --write .",
		"eslint:check": "eslint .",
		"eslint:fix": "eslint --fix .",
		"format": "prettier --write . && eslint --fix ."
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"dependencies": {
		"debounce-ts": "^1.0.2"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.4.0",
		"@vitest/coverage-v8": "^4.1.11",
		"eslint": "^10.9.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"globals": "^17.11.0",
		"happy-dom": "^20.11.12",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"publint": "^0.3.24",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.68.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	}
}
